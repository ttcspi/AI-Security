#!/usr/bin/env bash
# attack — a thin launcher for the attacker-agent so you don't type `python3 attacker.py`.
#
#   ./attack start      run the campaign          (= python3 attacker.py)
#   ./attack verify     reproduce + promote       (= python3 verify.py)
#   ./attack health     check the target is up
#   ./attack clean      delete the campaign/ workspace
#   ./attack help       show this
#
# Any extra args/env pass straight through, e.g.:  EPISODES=3 ./attack start
set -euo pipefail

# Resolve symlinks so `cd` lands in the real attacker-agent dir even when run via a PATH symlink.
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$d/$src"
done
cd "$(cd -P "$(dirname "$src")" && pwd)"
PY="${PYTHON:-python3}"
cmd="${1:-help}"
shift || true

case "$cmd" in
  start | attack | run)
    exec "$PY" attacker.py "$@"
    ;;
  verify)
    exec "$PY" verify.py "$@"
    ;;
  health)
    exec "$PY" - <<'PYEOF'
import lib.env  # loads .env
from lib.target import health, target_info
try:
    h = health()
    print(f"  {target_info['name']} up at {target_info['url']}")
    print(f"  model={h.get('model')}  hasKey={h.get('hasKey')}")
except Exception as e:
    print(f"  {target_info['name']} not reachable at {target_info['url']}: {e}")
    print(f"  {target_info['startHint']}")
    raise SystemExit(1)
PYEOF
    ;;
  clean)
    dir="${CAMPAIGN_DIR:-campaign}"
    rm -rf "$dir"
    echo "  removed $dir/"
    ;;
  help | -h | --help)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "  unknown command: $cmd" >&2
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
