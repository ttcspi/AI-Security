# attacker-agent — copy to .env:   cp .env.example .env
# The lab runs WITHOUT an attacker model (static escalation ladders). Add one to make it adaptive.

# --- The target --------------------------------------------------------------------------------------
# This project iterates against the local Chungus Assistant ("Chip"). Turn the profile on to attack it:
TARGET_PROFILE=chungus
CHUNGUS_TARGET_URL=http://localhost:8090/v1/chat/completions
CHUNGUS_TARGET_KEY=chungus-lab-key      # must match CHUNGUS_TARGET_KEY in ../chungus-assistant/.env

# (Default profile, if TARGET_PROFILE is unset, points at a Week-2 MerciBank target on :8080.)
# MERCI_TARGET_URL=http://localhost:8080/v1/chat/completions
# MERCI_TARGET_KEY=merci-lab-key

# --- The attacker's brain (OPTIONAL but recommended) -------------------------------------------------
# Any OpenAI-compatible endpoint. When set, the agent writes its OWN next message when the target refuses.
# Pick ONE:
#
# 1) OpenRouter (cloud, easy) — use a model served by many providers to avoid upstream rate-limits:
# ATTACKER_LLM_BASE_URL=https://openrouter.ai/api/v1
# ATTACKER_LLM_API_KEY=sk-or-...
# ATTACKER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#
# 2) Local, free, no bans (Mac: Ollama at 11434, or LM Studio at 1234):
# ATTACKER_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ATTACKER_LLM_API_KEY=local
# ATTACKER_LLM_MODEL=<the open model you loaded>
#
# Why local / a red-team-tuned model? An aligned cloud model often REFUSES to help write attacks, and
# attack traffic can get a commercial key flagged. A local open model (Ollama/LM Studio) or a red-team-
# tuned model avoids both — and everything still stays on your localhost lab, inside the ROE. Never point
# the attacker model or the target at anything but the lab.

# --- Campaign knobs (all optional) -------------------------------------------------------------------
# EPISODES=9            # how many attack laps to run
# MAX_TURNS=4           # max messages per strategy before giving up / escalating
# ATTACK_DELAY_MS=600   # pause between calls (keep under the target's rate limit)
# UCB_C=1.41            # explore/exploit knob for the planner
# REPRO_RUNS=3          # Day 6: how many parallel reproductions
# REPRO_MIN=3           # Day 6: how many must leak to CONFIRM (the "3 of 3" rule)
# CAMPAIGN_DIR=campaign # where findings/journal/traces are written
