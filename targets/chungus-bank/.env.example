# Chungus Bank target — copy to .env:   cp .env.example .env

# The bearer token the attacker/harness must send. Any value; it just has to match.
CHUNGUS_BANK_TARGET_KEY=chungus-bank-lab-key
PORT=8080

# --- The model behind the assistant: any OpenAI-compatible endpoint (REQUIRED) ---
# OpenRouter:
CHUNGUS_BANK_LLM_BASE_URL=https://openrouter.ai/api/v1
CHUNGUS_BANK_LLM_API_KEY=sk-or-REPLACE_ME
CHUNGUS_BANK_LLM_MODEL=openai/gpt-4o-mini

# Or OpenAI directly:
# CHUNGUS_BANK_LLM_BASE_URL=https://api.openai.com/v1
# CHUNGUS_BANK_LLM_API_KEY=sk-...
# CHUNGUS_BANK_LLM_MODEL=gpt-4o-mini
