# attacker-agent — copy to .env:   cp .env.example .env
# Runs WITHOUT an attacker model (static escalation ladders). Add one to make it adaptive.

# --- The target ---------------------------------------------------------------------------------------
# Pick a target by NAME from targets.json. `attack start <name>` overrides this per run.
TARGET=chungus-hr        # chungus-hr (:8090) or chungus-bank (:8080)
# Connection defaults come from each target's manifest.json; override the bearer token only if you
# changed it on the target side:
# CHUNGUS_HR_TARGET_KEY=chungus-lab-key
# CHUNGUS_BANK_TARGET_KEY=chungus-bank-lab-key

# --- The attacker's brain (OPTIONAL but recommended) --------------------------------------------------
# Any OpenAI-compatible endpoint. When set, the agent writes its OWN next message when the target refuses.
#
# 1) OpenRouter (cloud) — use a model served by many providers to avoid upstream rate-limits:
# ATTACKER_LLM_BASE_URL=https://openrouter.ai/api/v1
# ATTACKER_LLM_API_KEY=sk-or-...
# ATTACKER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#
# 2) Local, free, no bans (Mac: Ollama at 11434, or LM Studio at 1234):
# ATTACKER_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ATTACKER_LLM_API_KEY=local
# ATTACKER_LLM_MODEL=<the open model you loaded>
#
# An aligned cloud model often REFUSES to help write attacks, and attack traffic can get a commercial key
# flagged. A local open model avoids both — and everything still stays on your localhost lab, in the ROE.

# --- Campaign knobs (all optional) --------------------------------------------------------------------
# EPISODES=9            # how many attack laps to run
# MAX_TURNS=15          # max messages per strategy before giving up / escalating
# ATTACK_DELAY_MS=600   # pause between calls (keep under the target's rate limit)
# UCB_C=1.41            # explore/exploit knob for the planner
# REPRO_RUNS=3          # Day 6: how many parallel reproductions
# REPRO_MIN=3           # Day 6: how many must leak to CONFIRM (the "3 of 3" rule)
# CAMPAIGN_DIR=campaign # where findings/journal/traces are written
