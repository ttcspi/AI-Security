# Copy to .env  ->  cp .env.example .env

# The bearer token your test harness must send. Any value; it just has to match what the harness uses.
CHUNGUS_TARGET_KEY=chungus-lab-key
PORT=8090

# --- Chip's brain: any OpenAI-compatible model endpoint (REQUIRED) ---
# Put ONE provider's values here. The assistant won't answer without a key (GET /health shows hasKey).
# Use a model with reliable OpenAI-style function-calling, or the document tools won't fire.

# Option A — OpenAI directly:
CHUNGUS_LLM_BASE_URL=https://api.openai.com/v1
CHUNGUS_LLM_API_KEY=sk-...your-key...
CHUNGUS_LLM_MODEL=gpt-4o-mini

# Option B — OpenRouter:
# CHUNGUS_LLM_BASE_URL=https://openrouter.ai/api/v1
# CHUNGUS_LLM_API_KEY=sk-or-...your-key...
# CHUNGUS_LLM_MODEL=openai/gpt-4o-mini

# Option C — a local / self-hosted model (e.g. Ollama, or your RunPod Ollama over a tunnel):
# CHUNGUS_LLM_BASE_URL=http://localhost:11434/v1
# CHUNGUS_LLM_API_KEY=ollama
# CHUNGUS_LLM_MODEL=qwen2.5:7b
